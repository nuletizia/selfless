{
  "manifest_version": 3,
  "name": "Selfless",
  "short_name": "Selfless",
  "version": "0.1.0",
  "description": "Self-citation and co-author citation filters for Google Scholar profiles, computed with OpenAlex.",
  "homepage_url": "https://github.com/nuletizia/selfless",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.openalex.org/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/citations*",
        "https://scholar.google.ae/citations*",
        "https://scholar.google.at/citations*",
        "https://scholar.google.be/citations*",
        "https://scholar.google.bg/citations*",
        "https://scholar.google.ca/citations*",
        "https://scholar.google.ch/citations*",
        "https://scholar.google.cl/citations*",
        "https://scholar.google.cn/citations*",
        "https://scholar.google.co.id/citations*",
        "https://scholar.google.co.il/citations*",
        "https://scholar.google.co.in/citations*",
        "https://scholar.google.co.jp/citations*",
        "https://scholar.google.co.kr/citations*",
        "https://scholar.google.co.nz/citations*",
        "https://scholar.google.co.th/citations*",
        "https://scholar.google.co.uk/citations*",
        "https://scholar.google.co.za/citations*",
        "https://scholar.google.com.ar/citations*",
        "https://scholar.google.com.au/citations*",
        "https://scholar.google.com.br/citations*",
        "https://scholar.google.com.co/citations*",
        "https://scholar.google.com.eg/citations*",
        "https://scholar.google.com.hk/citations*",
        "https://scholar.google.com.mx/citations*",
        "https://scholar.google.com.my/citations*",
        "https://scholar.google.com.pk/citations*",
        "https://scholar.google.com.sg/citations*",
        "https://scholar.google.com.tr/citations*",
        "https://scholar.google.com.tw/citations*",
        "https://scholar.google.com.ua/citations*",
        "https://scholar.google.com.vn/citations*",
        "https://scholar.google.cz/citations*",
        "https://scholar.google.de/citations*",
        "https://scholar.google.dk/citations*",
        "https://scholar.google.es/citations*",
        "https://scholar.google.fi/citations*",
        "https://scholar.google.fr/citations*",
        "https://scholar.google.gr/citations*",
        "https://scholar.google.hr/citations*",
        "https://scholar.google.hu/citations*",
        "https://scholar.google.ie/citations*",
        "https://scholar.google.it/citations*",
        "https://scholar.google.lt/citations*",
        "https://scholar.google.nl/citations*",
        "https://scholar.google.no/citations*",
        "https://scholar.google.pl/citations*",
        "https://scholar.google.pt/citations*",
        "https://scholar.google.ro/citations*",
        "https://scholar.google.rs/citations*",
        "https://scholar.google.ru/citations*",
        "https://scholar.google.se/citations*",
        "https://scholar.google.si/citations*",
        "https://scholar.google.sk/citations*"
      ],
      "include_globs": [
        "*user=*"
      ],
      "js": [
        "src/content/scholar-dom.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/selfless.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.openalex.org"
  },
  "minimum_chrome_version": "116"
}
